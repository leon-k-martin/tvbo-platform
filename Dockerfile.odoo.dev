# Odoo container for LOCAL DEVELOPMENT
# Pre-installs all tvbo dependencies, then mounts source for editable install
FROM odoo:19

USER root

# Set locale
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    LANGUAGE=C.UTF-8

# Install uv + minimal system dependencies
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_SYSTEM_PYTHON=1 \
    UV_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libcairo2-dev \
        libpango1.0-dev \
        git \
        locales && \
    echo "en_US.UTF-8 UTF-8" > /etc/locale.gen && \
    locale-gen && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Pre-install all tvbo core dependencies so the editable mount is instant
RUN uv pip install --ignore-installed typing-extensions \
    scipy numpy pandas \
    pydantic linkml-runtime PyYAML \
    owlready2 rdflib \
    jax equinox \
    sympy \
    matplotlib networkx pydot \
    mako \
    pybtex pypdf autopep8 black

# Copy init script
COPY init-odoo.sh /init-odoo.sh
RUN chmod +x /init-odoo.sh

USER odoo
ENTRYPOINT ["/init-odoo.sh"]
