<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main TVBO Menu -->
    <menuitem id="menu_tvbo_root"
              name="TVBO Database"
              sequence="20"
              groups="base.group_user"
              web_icon="tvbo,static/description/icon.png"/>

    <!-- Database submenu -->
    <menuitem id="menu_tvbo_database"
              name="Browse Database"
              parent="menu_tvbo_root"
              sequence="10"/>

    <!-- Dynamics -->
    <menuitem id="menu_dynamics"
              name="Dynamics"
              parent="menu_tvbo_database"
              action="action_dynamics_list"
              sequence="10"/>

    <!-- Integrators -->
    <menuitem id="menu_integrator"
              name="Integrators"
              parent="menu_tvbo_database"
              action="action_integrator_list"
              sequence="20"/>

    <!-- Connectivity Networks -->
    <menuitem id="menu_network"
              name="Connectivity Networks"
              parent="menu_tvbo_database"
              action="action_network_list"
              sequence="30"/>

    <!-- Research Studies -->
    <menuitem id="menu_simulation_study"
              name="Research Studies"
              parent="menu_tvbo_database"
              action="action_simulation_study_list"
              sequence="40"/>

    <!-- Coupling Functions -->
    <menuitem id="menu_coupling"
              name="Coupling Functions"
              parent="menu_tvbo_database"
              action="action_coupling_list"
              sequence="50"/>

    <!-- Brain Atlases -->
    <menuitem id="menu_brain_atlas"
              name="Brain Atlases"
              parent="menu_tvbo_database"
              action="action_brain_atlas_list"
              sequence="60"/>

    <!-- Tractograms -->
    <menuitem id="menu_tractogram"
              name="Tractograms"
              parent="menu_tvbo_database"
              action="action_tractogram_list"
              sequence="70"/>

    <!-- Parcellations -->
    <menuitem id="menu_parcellation"
              name="Parcellations"
              parent="menu_tvbo_database"
              action="action_parcellation_list"
              sequence="80"/>

    <!-- Simulation Experiments -->
    <menuitem id="menu_simulation_experiment"
              name="Simulation Experiments"
              parent="menu_tvbo_database"
              action="action_simulation_experiment_list"
              sequence="90"/>

    <!-- Observations -->
    <menuitem id="menu_observation"
              name="Observations"
              parent="menu_tvbo_database"
              action="action_observation_list"
              sequence="100"/>

    <!-- Home screen: Lab first (tvbo_lab), then collaboration from 6 (To-do keeps its 10), the platform apps from 20, then Dashboards, Apps and Settings. -->
    <record id="mail.menu_root_discuss" model="ir.ui.menu"><field name="sequence">6</field></record>
    <record id="contacts.menu_contacts" model="ir.ui.menu"><field name="sequence">11</field></record>
    <record id="tvbo_platform_docs.menu_tvbo_docs_root" model="ir.ui.menu"><field name="sequence">21</field></record>
    <record id="website.menu_website_configuration" model="ir.ui.menu"><field name="sequence">22</field></record>
    <record id="survey.menu_surveys" model="ir.ui.menu"><field name="sequence">23</field></record>
    <record id="mass_mailing.mass_mailing_menu_root" model="ir.ui.menu"><field name="sequence">24</field></record>
</odoo>