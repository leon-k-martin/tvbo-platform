    <record model="survey.question" id="ws_pre_s3_q2">
        <field name="survey_id" ref="survey_tvbo_preworkshop"/>
        <field name="sequence">32</field>
        <field name="title">Which other programming languages do you use regularly? (select all that apply)</field>
        <field name="question_type">multiple_choice</field>
        <field name="constr_mandatory" eval="False"/>
    </record>
    <record model="survey.question.answer" id="ws_pre_s3_q2_a1">
        <field name="question_id" ref="ws_pre_s3_q2"/>
        <field name="sequence">1</field>
        <field name="value">MATLAB</field>
    </record>
    <record model="survey.question.answer" id="ws_pre_s3_q2_a2">
        <field name="question_id" ref="ws_pre_s3_q2"/>
        <field name="sequence">2</field>
        <field name="value">R</field>
    </record>
    <record model="survey.question.answer" id="ws_pre_s3_q2_a3">
        <field name="question_id" ref="ws_pre_s3_q2"/>
        <field name="sequence">3</field>
        <field name="value">Julia</field>
    </record>
    <record model="survey.question.answer" id="ws_pre_s3_q2_a4">
        <field name="question_id" ref="ws_pre_s3_q2"/>
