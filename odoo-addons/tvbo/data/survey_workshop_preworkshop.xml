    <record model="survey.question.answer" id="ws_pre_s4_q1_a5">
        <field name="question_id" ref="ws_pre_s4_q1"/>
        <field name="sequence">5</field>
        <field name="value">Parameter optimisation / model fitting to empirical data</field>
    </record>
    <record model="survey.question.answer" id="ws_pre_s4_q1_a6">
        <field name="question_id" ref="ws_pre_s4_q1"/>
        <field name="sequence">6</field>
