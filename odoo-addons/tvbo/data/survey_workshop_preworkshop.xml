    </record>
    <record model="survey.question.answer" id="ws_pre_s3_q3_a3">
        <field name="question_id" ref="ws_pre_s3_q3"/>
        <field name="sequence">3</field>
        <field name="value">Windows</field>
    </record>
    <record model="survey.question.answer" id="ws_pre_s3_q3_a4">
        <field name="question_id" ref="ws_pre_s3_q3"/>
        <field name="sequence">4</field>
        <field name="value">I will use EBRAINS JupyterHub (cloud — no local install)</field>
    </record>

    <!-- ============================================================
         Section 4: Expectations
         ============================================================ -->
    <record model="survey.question" id="ws_pre_s4">
        <field name="survey_id" ref="survey_tvbo_preworkshop"/>
        <field name="sequence">40</field>
        <field name="title">Expectations</field>
        <field name="is_page" eval="True"/>
        <field name="question_type" eval="False"/>
    </record>

