    <record model="survey.question.answer" id="ws_pre_s4_q1_a1">
        <field name="question_id" ref="ws_pre_s4_q1"/>
        <field name="sequence">1</field>
        <field name="value">Understanding whole-brain network modelling concepts</field>
    </record>
    <record model="survey.question.answer" id="ws_pre_s4_q1_a2">
        <field name="question_id" ref="ws_pre_s4_q1"/>
        <field name="sequence">2</field>
        <field name="value">Hands-on experience running whole-brain network simulations</field>
    </record>
    <record model="survey.question.answer" id="ws_pre_s4_q1_a3">
        <field name="question_id" ref="ws_pre_s4_q1"/>
        <field name="sequence">3</field>
        <field name="value">Learning about FAIR / open-science practices for brain models</field>
    </record>
    <record model="survey.question.answer" id="ws_pre_s4_q1_a4">
        <field name="question_id" ref="ws_pre_s4_q1"/>
        <field name="sequence">4</field>
