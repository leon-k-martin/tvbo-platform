    <record model="survey.question.answer" id="ws_pre_s3_q1_a4">
        <field name="question_id" ref="ws_pre_s3_q1"/>
        <field name="sequence">4</field>
        <field name="value">Advanced — develop packages, use JAX/PyTorch, contribute to open-source</field>
    </record>

