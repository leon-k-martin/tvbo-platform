    <record model="survey.question" id="ws_pre_s4_q1">
        <field name="survey_id" ref="survey_tvbo_preworkshop"/>
        <field name="sequence">41</field>
        <field name="title">What are you most hoping to get out of the workshop? (select up to 3)</field>
        <field name="question_type">multiple_choice</field>
        <field name="constr_mandatory" eval="True"/>
