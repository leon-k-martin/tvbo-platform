<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="team_view_list" model="ir.ui.view">
        <field name="name">hr.employee.list.lab_team</field>
        <field name="model">hr.employee</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="active" column_invisible="True"/>
                <field name="name"/>
                <field name="job_id"/>
                <field name="employee_type"/>
                <field name="contract_date_start" string="Start"/>
                <field name="contract_date_end" string="End"/>
                <field name="departure_date" string="Left"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="team_view_search" model="ir.ui.view">
        <field name="name">hr.employee.search.lab_team</field>
        <field name="model">hr.employee</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="job_id"/>
                <filter name="current" string="Current" domain="[('active', '=', True)]"/>
                <filter name="former" string="Former" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_job" string="Position" context="{'group_by': 'job_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'employee_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Naming both values of active lists former members next to current ones without switching off active_test for every view opened from here. -->
    <record id="action_team" model="ir.actions.act_window">
        <field name="name">Team</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('active', '=', True), ('active', '=', False)]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('team_view_list')})]"/>
        <field name="search_view_id" ref="team_view_search"/>
    </record>

    <record id="student_project_view_list" model="ir.ui.view">
        <field name="name">lab.student_project.list</field>
        <field name="model">lab.student_project</field>
        <field name="arch" type="xml">
            <list decoration-danger="date_end and date_end &lt; current_date and state in ('planned', 'running')" decoration-muted="state == 'done'">
                <field name="name"/>
                <field name="kind"/>
                <field name="student_id" widget="many2one_avatar_employee"/>
                <field name="supervisor_ids" widget="many2many_avatar_user" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge" decoration-info="state == 'running'" decoration-warning="state == 'submitted'" decoration-success="state == 'done'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="student_project_view_kanban" model="ir.ui.view">
        <field name="name">lab.student_project.kanban</field>
        <field name="model">lab.student_project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="kind" class="text-muted"/>
                        <footer class="pt-1">
                            <field name="student_id" widget="many2one_avatar_employee" options="{'display_avatar_name': True}" readonly="1"/>
                            <div class="d-flex align-items-center gap-2 ms-auto">
                                <field name="date_end" widget="remaining_days" invisible="state in ('submitted', 'done')"/>
                                <field name="activity_ids" widget="kanban_activity"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="student_project_view_form" model="ir.ui.view">
        <field name="name">lab.student_project.form</field>
        <field name="model">lab.student_project</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Fitting a neural mass model to resting-state fMRI"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="student_id" widget="many2one_avatar_employee"/>
                            <field name="supervisor_ids" widget="many2many_avatar_user"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="student_project_view_search" model="ir.ui.view">
        <field name="name">lab.student_project.search</field>
        <field name="model">lab.student_project</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="supervisor_ids"/>
                <filter name="mine" string="I supervise" domain="[('supervisor_ids', 'in', uid)]"/>
                <filter name="current" string="Current" domain="[('state', '!=', 'done')]"/>
                <group>
                    <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_student_project" model="ir.actions.act_window">
        <field name="name">Student projects</field>
        <field name="res_model">lab.student_project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add an internship, lab rotation or thesis</p>
            <p>Record who does it, who supervises it and when it ends, then move it from Planned to Done as it goes. Add the student under Employees first, with the type Student or Trainee.</p>
        </field>
    </record>

    <menuitem id="menu_team" name="Team (admin)" parent="hr.menu_hr_root" action="action_team" sequence="5" groups="group_lab_manager"/>
    <menuitem id="menu_student_project" name="Student projects" parent="hr.menu_hr_root" action="action_student_project" sequence="3" groups="group_lab_member"/>
</odoo>
