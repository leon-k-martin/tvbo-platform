<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="funding_allocation_view_list" model="ir.ui.view">
        <field name="name">lab.funding_allocation.list</field>
        <field name="model">lab.funding_allocation</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="employee_id"/>
                <field name="task_id" domain="[('project_id.allow_timesheets', '=', True)]"/>
                <field name="project_id"/>
                <field name="percentage"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_funding_allocation" model="ir.actions.act_window">
        <field name="name">Funding</field>
        <field name="res_model">lab.funding_allocation</field>
        <field name="view_mode">list</field>
        <field name="context">{'group_by': 'employee_id'}</field>
    </record>

    <record id="timesheet_month_view_form" model="ir.ui.view">
        <field name="name">lab.timesheet_month.form</field>
        <field name="model">lab.timesheet_month</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="employee_id" groups="tvbo_lab.group_lab_manager"/>
                    <field name="month"/>
                    <field name="project_id"/>
                </group>
                <div class="text-muted">Fills your working days up to today. Click Prefill again later in the month to add the rest.</div>
                <footer>
                    <button name="action_prefill" string="Prefill from funding" type="object" class="btn-primary"/>
                    <button name="action_export_eu_sheet" string="Export EU sheet" type="object" invisible="not project_id"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_timesheet_month" model="ir.actions.act_window">
        <field name="name">Monthly Sheet</field>
        <field name="res_model">lab.timesheet_month</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_timesheet_month" name="Monthly Sheet" parent="hr_timesheet.timesheet_menu_root" action="action_timesheet_month" sequence="20" groups="group_lab_member"/>
    <menuitem id="menu_funding_allocation" name="Funding" parent="hr_timesheet.timesheet_menu_root" action="action_funding_allocation" sequence="30" groups="group_lab_member"/>

    <record id="view_company_form" model="ir.ui.view">
        <field name="name">res.company.form.lab</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page string="Lab" name="lab">
                    <group>
                        <field name="lab_eu_timesheet_template"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="public_holiday_view_list" model="ir.ui.view">
        <field name="name">resource.calendar.leaves.list.lab</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="inherit_id" ref="hr_holidays.resource_calendar_leaves_tree_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_import_public_holidays" string="Import public holidays" type="object" display="always" groups="tvbo_lab.group_lab_manager"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
