<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//nav[hasclass('o_main_navbar')]" position="before">
            <div class="o_site_header d-print-none">
                <a href="/" class="o_site_header_brand" title="Go to the website">
                    <img t-if="siteHeader.logo" class="o_site_header_logo" t-att-src="siteHeader.logo" alt=""/>
                    <span t-esc="siteHeader.name"/>
                </a>
                <span class="o_site_header_badge">Backend</span>
                <Dropdown>
                    <button type="button" class="o_site_header_account">
                        <i class="fa fa-user-circle-o" aria-hidden="true"/>
                        <span t-att-class="{ 'visually-hidden': ui.isSmall }" t-esc="userName"/>
                        <i class="fa fa-caret-down" aria-hidden="true"/>
                    </button>
                    <t t-set-slot="content">
                        <t t-foreach="accountMenu" t-as="entry" t-key="entry.key">
                            <div t-if="entry.key === 'logout'" class="dropdown-divider"/>
                            <DropdownItem attrs="{ href: entry.url }" onSelected="() => this.onAccountEntry(entry)"><i t-attf-class="fa fa-fw {{ entry.icon }} me-2" aria-hidden="true"/><t t-esc="entry.label"/></DropdownItem>
                        </t>
                    </t>
                </Dropdown>
            </div>
        </xpath>
    </t>

</templates>
