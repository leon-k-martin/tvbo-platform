# Odoo container with the tvbo Python package + an Odoo model layer GENERATED
# from the tvbo LinkML ground-truth at build time.
#
# There is no committed schema_models.py / ir.model.access.csv: both are emitted
# here from the tvbo schema, so the platform always follows the ground truth and
# there is nothing to keep in sync by hand. Heavy computations run in a separate
# tvbo container via API.
#
# The schema is fetched from the tvbo GitHub repo (a sparse checkout of schema/),
# NOT from the installed wheel — the wheel doesn't ship it. "Follow latest" =
# build against TVBO_SCHEMA_REF (default: main). The fetched YAMLs are also staged
# into the runtime image for /tvbo/api/kg/schema. To freeze for a release, pass
# --build-arg TVBO_SCHEMA_REF=<tag> (and optionally --build-arg TVBO_VERSION=X.Y.Z
# to pin the runtime tvbo package).

ARG TVBO_SCHEMA_REPO=https://github.com/virtual-twin/tvbo
ARG TVBO_SCHEMA_REF=main
ARG TVBO_VERSION=
# CI passes CACHE_BUST=${github.sha}; it busts the schema-fetch layer so each
# build re-clones the latest schema instead of reusing a cached checkout.
ARG CACHE_BUST=1

# ---- Stage 1: generate the Odoo model layer from the tvbo ground truth ------
FROM odoo:19 AS schemagen
USER root
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_SYSTEM_PYTHON=1 \
    UV_BREAK_SYSTEM_PACKAGES=1

# git to fetch the schema; linkml is the generator engine. Both build-time only,
# kept out of the runtime image by this separate stage. (tvbo itself is NOT needed
# here: the generator reads the schema via --schema and imports only linkml.)
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
RUN uv pip install --reinstall linkml

# Sparse-checkout just schema/ from the tvbo repo at the requested ref. Pulling
# the whole dir (not a hardcoded file list) keeps this correct as the schema's
# LinkML imports evolve.
ARG TVBO_SCHEMA_REPO
ARG TVBO_SCHEMA_REF
ARG CACHE_BUST
RUN echo "schema fetch (cache-bust=$CACHE_BUST) ref=$TVBO_SCHEMA_REF" \
    && git clone --depth 1 --filter=blob:none --sparse --branch "$TVBO_SCHEMA_REF" \
        "$TVBO_SCHEMA_REPO" /opt/tvbo-src \
    && git -C /opt/tvbo-src sparse-checkout set schema

# Generate schema_models.py + security/ir.model.access.csv (a single --out drives
# both outputs under the addon root), and stage the schema YAMLs for the runtime.
COPY scripts /opt/gen/scripts
RUN python3 /opt/gen/scripts/generate_odoo_models.py \
        --schema /opt/tvbo-src/schema/tvbo_datamodel.yaml \
        --out /opt/out/tvbo/models/schema_models.py \
    && mkdir -p /opt/out/schema \
    && cp /opt/tvbo-src/schema/*.yaml /opt/out/schema/ \
    && echo "Generated tvbo Odoo layer from schema ref '$TVBO_SCHEMA_REF'"

# ---- Stage 2: runtime image -------------------------------------------------
FROM odoo:19
USER root

# Set locale
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    LANGUAGE=C.UTF-8

# Install uv (fast package installer) — no apt needed, all deps ship as wheels
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_SYSTEM_PYTHON=1 \
    UV_BREAK_SYSTEM_PACKAGES=1

# Install the tvbo package (for model loading and the REST API; not heavy compute).
# No linkml here — the runtime never generates. Pin with --build-arg TVBO_VERSION.
ARG TVBO_VERSION
RUN uv pip install --reinstall typing-extensions "tvbo${TVBO_VERSION:+==$TVBO_VERSION}"

# Copy the hand-written addon sources (schema_models.py / ir.model.access.csv are
# excluded via .dockerignore — they are supplied by the generator below).
COPY odoo-addons /mnt/extra-addons

# Overlay the generated, ground-truth-derived model layer.
COPY --from=schemagen /opt/out/tvbo/models/schema_models.py \
     /mnt/extra-addons/tvbo/models/schema_models.py
COPY --from=schemagen /opt/out/tvbo/security/ir.model.access.csv \
     /mnt/extra-addons/tvbo/security/ir.model.access.csv

# Stage the schema YAMLs where building_blocks_api._locate_schema_file() looks, so
# the runtime /tvbo/api/kg/schema endpoint resolves the same ground truth.
COPY --from=schemagen /opt/out/schema /tvbo/schema

# Version-independent schema reconciler, run before/after every -u tvbo by
# init-odoo.sh (bridges follow-latest schema changes with no module version bump).
COPY scripts/reconcile_schema.py /opt/tvbo/reconcile_schema.py
ENV TVBO_RECONCILE_PY=/opt/tvbo/reconcile_schema.py

# Force rebuild from here when init script changes
ARG CACHE_BUST=1
# Copy init script
COPY init-odoo.sh /init-odoo.sh
RUN chmod +x /init-odoo.sh

USER odoo
ENTRYPOINT ["/init-odoo.sh"]
