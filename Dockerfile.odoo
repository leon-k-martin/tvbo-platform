# Odoo container with tvbo Python package for API integration
# Heavy computations run in separate tvbo container via API
FROM odoo:19

USER root

# Set locale
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    LANGUAGE=C.UTF-8

# Install uv (fast package installer) — no apt needed, all deps ship as wheels
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_SYSTEM_PYTHON=1 \
    UV_BREAK_SYSTEM_PACKAGES=1

# Install tvbo Python package (for model loading, not heavy compute)
RUN uv pip install --reinstall typing-extensions tvbo

# Copy the Odoo addons
COPY odoo-addons /mnt/extra-addons

# Force rebuild from here when init script changes
ARG CACHE_BUST=1
# Copy init script
COPY init-odoo.sh /init-odoo.sh
RUN chmod +x /init-odoo.sh

USER odoo
ENTRYPOINT ["/init-odoo.sh"]
